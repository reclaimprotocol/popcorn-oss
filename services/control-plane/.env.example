# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_USER=analytics_admin
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=analytics
DATABASE_SSL=false

# Or use DATABASE_URL directly
# DATABASE_URL=postgresql://analytics_admin:password@localhost:5432/analytics

# Authentication Tokens
CONTROL_PLANE_SERVICE_AUTH_TOKEN=your_service_token_here
CONTROL_PLANE_ADMIN_TOKEN=your_admin_token_here

# Region Routing
CONTROL_PLANE_REGIONS='[{"name":"local","clusterName":"local","poolManagerUrl":"http://pool-manager.default.svc.cluster.local","publicGatewayUrl":"http://localhost:8080","enabled":true}]'
