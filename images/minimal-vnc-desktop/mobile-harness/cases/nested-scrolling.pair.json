{
  "schemaVersion": 1,
  "name": "nested-scrolling",
  "testDescription": "Three forward native swipes, one reverse swipe, and a final forward swipe inside an inner scrollable list must reveal its target row while the outer page remains at the same scroll position. Rendering scale and exact scroll distance may differ between Safari and LiveView.",
  "testPage": "cases/nested-scrolling.html",
  "baseline": {
    "fixturePath": "cases/nested-scrolling.html"
  },
  "candidate": {
    "setupActions": []
  },
  "candidateActionFailureVerdict": "FAIL",
  "recordingStart": {
    "name": "case-ready",
    "color": "#2b005f",
    "timeoutMs": 30000
  },
  "actions": [
    {
      "type": "waitForColor",
      "name": "ready",
      "color": "#2b005f",
      "timeoutMs": 30000
    },
    {
      "type": "screenshot",
      "name": "before-inner-scroll",
      "syncWith": "ready"
    },
    {
      "type": "swipe",
      "name": "scroll-inner-list-one",
      "fromX": 200,
      "fromY": 440,
      "toX": 200,
      "toY": 280,
      "durationMs": 700,
      "platformOverrides": { "Android": { "durationMs": 300 } }
    },
    { "type": "wait", "ms": 350 },
    {
      "type": "swipe",
      "name": "scroll-inner-list-two",
      "fromX": 200,
      "fromY": 440,
      "toX": 200,
      "toY": 280,
      "durationMs": 700,
      "platformOverrides": { "Android": { "durationMs": 300 } }
    },
    { "type": "wait", "ms": 350 },
    {
      "type": "swipe",
      "name": "scroll-inner-list-three",
      "fromX": 200,
      "fromY": 440,
      "toX": 200,
      "toY": 280,
      "durationMs": 700,
      "platformOverrides": { "Android": { "durationMs": 300 } }
    },
    { "type": "wait", "ms": 350 },
    {
      "type": "swipe",
      "name": "scroll-inner-list-reverse",
      "fromX": 200,
      "fromY": 280,
      "toX": 200,
      "toY": 400,
      "durationMs": 650,
      "platformOverrides": { "Android": { "durationMs": 300 } }
    },
    { "type": "wait", "ms": 350 },
    {
      "type": "swipe",
      "name": "scroll-inner-list-final",
      "fromX": 200,
      "fromY": 440,
      "toX": 200,
      "toY": 260,
      "durationMs": 700,
      "platformOverrides": { "Android": { "durationMs": 300 } }
    },
    {
      "type": "waitForColor",
      "name": "target-row-visible",
      "color": "#00d084",
      "timeoutMs": 30000
    },
    {
      "type": "waitForColor",
      "name": "outer-page-stable",
      "color": "#2b005f",
      "timeoutMs": 30000
    },
    {
      "type": "wait",
      "ms": 600
    },
    {
      "type": "waitForColor",
      "name": "nested-scroll-settled",
      "color": "#00d084",
      "timeoutMs": 30000
    },
    {
      "type": "screenshot",
      "name": "after-inner-scroll",
      "syncWith": "nested-scroll-settled"
    }
  ],
  "compare": {
    "profile": "relative-transition-diff",
    "from": "before-inner-scroll",
    "to": "after-inner-scroll",
    "pixelThreshold": 0.15,
    "maxTransitionRatioDelta": 0.2
  }
