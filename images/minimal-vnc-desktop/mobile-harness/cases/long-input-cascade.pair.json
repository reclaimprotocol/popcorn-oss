    { "type": "dragRelativeToColorByOffset", "name": "scroll-to-email", "sourceColor": "#84cc16", "deltaX": 0, "deltaY": -100, "durationMs": 750, "steps": 10, "tolerance": 35 },
    { "type": "waitForColor", "name": "email-visible", "color": "#0369a1", "timeoutMs": 30000 },
    { "type": "tapRelativeToColor", "name": "focus-email", "color": "#0369a1", "offsetX": 0, "tolerance": 35 },
