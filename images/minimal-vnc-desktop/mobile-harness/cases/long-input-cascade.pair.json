    { "type": "dragRelativeToColorByOffset", "name": "scroll-to-notes", "sourceColor": "#4d7c0f", "deltaX": 0, "deltaY": -100, "durationMs": 750, "steps": 10, "tolerance": 35 },
    { "type": "waitForColor", "name": "notes-visible", "color": "#06b6d4", "timeoutMs": 30000 },
