{
  "schemaVersion": 1,
  "name": "long-input-cascade",
  "testDescription": "A compact long form with text, email, telephone, textarea, and numeric inputs must keep each directly tapped field clear of mobile browser chrome and above the keyboard while the user scrolls, switches fields, and types without placement drift or a black band.",
  "testPage": "cases/long-input-cascade.html",
  "baseline": { "fixturePath": "cases/long-input-cascade.html" },
  "candidate": { "setupActions": [] },
  "candidateActionFailureVerdict": "FAIL",
  "recordingStart": { "name": "case-ready", "color": "#2b005f", "timeoutMs": 30000 },
  "actions": [
