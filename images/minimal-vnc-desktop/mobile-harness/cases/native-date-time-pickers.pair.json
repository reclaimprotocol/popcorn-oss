{
  "schemaVersion": 1,
  "name": "native-date-time-pickers",
  "testDescription": "Native date and time controls must accept changed wheel values and return those changes to the page.",
  "testPage": "cases/native-date-time-pickers.html",
  "baseline": { "fixturePath": "cases/native-date-time-pickers.html" },
  "candidate": { "setupActions": [] },
  "candidateActionFailureVerdict": "FAIL",
  "recordingStart": { "name": "case-ready", "color": "#2b005f", "timeoutMs": 30000 },
  "actions": [
    { "type": "waitForColor", "name": "ready", "color": "#2b005f", "timeoutMs": 30000 },
    { "type": "screenshot", "name": "before-pickers", "syncWith": "ready" },
    { "type": "tapRelativeToColor", "name": "open-date", "color": "#dcfce7", "offsetY": -50, "tolerance": 8 },
    { "type": "wait", "ms": 700 },
    { "type": "tapNativeElement", "name": "choose-next-date", "android": {"text": "22"}, "ios": {"label": "22"}, "settleMs": 300 },
    { "type": "tapNativeElement", "name": "confirm-date", "android": {"resourceId": "android:id/button1"}, "ios": {"label": "Done"}, "settleMs": 400 },
    { "type": "waitForColor", "name": "date-changed", "color": "#ffe600", "timeoutMs": 30000 },
    { "type": "tapRelativeToColor", "name": "open-time", "color": "#dcfce7", "offsetY": 50, "tolerance": 8, "targetOverrides": {"candidate": {"offsetY": 100}} },
    { "type": "wait", "ms": 700 },
    { "type": "screenshot", "name": "time-picker-open" },
    { "type": "tapNativeElement", "name": "change-time-wheel", "android": {"description": "11"}, "ios": {"pickerValue": "11"}, "settleMs": 300 },
    { "type": "tapNativeElement", "name": "confirm-time", "android": {"resourceId": "android:id/button1"}, "ios": {"label": "Done"}, "settleMs": 400 },
    { "type": "waitForColor", "name": "date-time-changed", "color": "#00d084", "timeoutMs": 30000 },
    { "type": "screenshot", "name": "after-pickers", "syncWith": "date-time-changed" }
  ],
  "compare": { "profile": "relative-transition-diff", "from": "before-pickers", "to": "after-pickers", "pixelThreshold": 0.15, "maxTransitionRatioDelta": 0.2 }
}
