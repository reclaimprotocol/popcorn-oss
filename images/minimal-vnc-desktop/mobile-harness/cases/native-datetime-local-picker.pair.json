{
  "schemaVersion": 1,
  "name": "native-datetime-local-picker",
  "testDescription": "A datetime-local input must open the combined iOS calendar/time picker in Safari and LiveView and commit August 29 at 11:16.",
  "testPage": "cases/native-datetime-local-picker.html",
  "baseline": { "fixturePath": "cases/native-datetime-local-picker.html" },
  "candidate": { "setupActions": [] },
  "candidateActionFailureVerdict": "FAIL",
  "recordingStart": { "name": "case-ready", "color": "#2b005f", "timeoutMs": 30000 },
  "actions": [
    { "type": "waitForColor", "name": "ready", "color": "#2b005f", "timeoutMs": 30000 },
    { "type": "screenshot", "name": "before-picker", "syncWith": "ready" },
    { "type": "tapRelativeToColor", "name": "open-datetime-picker", "color": "#dcfce7", "tolerance": 8 },
    { "type": "wait", "ms": 800 },
    { "type": "screenshot", "name": "calendar-open" },
    { "type": "tapNativeElement", "name": "step-day-to-24", "android": {"text": "24"}, "platforms": ["Android"], "settleMs": 250 },
    { "type": "tapNativeElement", "name": "step-day-to-25", "android": {"text": "25"}, "platforms": ["Android"], "settleMs": 250 },
    { "type": "tapNativeElement", "name": "step-day-to-26", "android": {"text": "26"}, "platforms": ["Android"], "settleMs": 250 },
    { "type": "tapNativeElement", "name": "step-day-to-27", "android": {"text": "27"}, "platforms": ["Android"], "settleMs": 250 },
    { "type": "tapNativeElement", "name": "step-day-to-28", "android": {"text": "28"}, "platforms": ["Android"], "settleMs": 250 },
    { "type": "tapNativeElement", "name": "step-day-to-29", "android": {"text": "29"}, "platforms": ["Android"], "settleMs": 250 },
    { "type": "tapNativeElement", "name": "set-day-wheel", "ios": {"pickerValue": "29", "wheelIndex": 2}, "platforms": ["iOS"], "settleMs": 300 },
    { "type": "wait", "ms": 500 },
    { "type": "screenshot", "name": "time-pane-open" },
    { "type": "tapNativeElement", "name": "choose-hour-11", "android": {"text": "11"}, "ios": {"pickerValue": "11", "wheelIndex": 3}, "settleMs": 300 },
    { "type": "tapNativeElement", "name": "choose-minute-16", "android": {"text": "16"}, "ios": {"pickerValue": "16", "wheelIndex": 4}, "settleMs": 300 },
    { "type": "tapNativeElement", "name": "confirm-datetime", "android": {"resourceId": "android:id/button1"}, "ios": {"label": "Done"}, "settleMs": 400 },
    { "type": "waitForColor", "name": "datetime-selected", "color": "#00d084", "timeoutMs": 30000 },
    { "type": "screenshot", "name": "after-selection", "syncWith": "datetime-selected" }
  ],
  "compare": { "profile": "relative-transition-diff", "from": "before-picker", "to": "after-selection", "pixelThreshold": 0.15, "maxTransitionRatioDelta": 0.2 }
}
