#!/usr/bin/env bash
set -euo pipefail

WIDTH="${WIDTH:-1920}"
HEIGHT="${HEIGHT:-1080}"
# The window must be as tall as the X screen's BOOT height, not the nominal desktop
# height: under --kiosk the window is never resized again for the life of the session,
# and any framebuffer taller than it (fit-to-width asks for ~1873 rows) renders the
# uncovered rows as the black X root. Kept in sync with entrypoint.sh's FB_HEIGHT,
# which explains the arithmetic.
WINDOW_HEIGHT="${FB_HEIGHT:-$HEIGHT}"
if (( WINDOW_HEIGHT < HEIGHT )); then WINDOW_HEIGHT="$HEIGHT"; fi
RECLAIM_LOADING_PAGE="https://reclaim-portal-loading-page.s3.ap-south-1.amazonaws.com/index.html"
FALLBACK_PAGE="https://start.duckduckgo.com/"
REPLACE_DEFAULT_PAGE="${REPLACE_DEFAULT_PAGE:-false}"
if [[ "$REPLACE_DEFAULT_PAGE" == "true" ]]; then
  DEFAULT_PAGE="$RECLAIM_LOADING_PAGE"
else
  DEFAULT_PAGE="$FALLBACK_PAGE"
fi
APP_URL="${APP_URL:-${POPCORN_BROWSER_STARTUP_URL:-${CHROMIUM_STARTUP_URL:-$DEFAULT_PAGE}}}"
CDP_INTERNAL_PORT="${CDP_INTERNAL_PORT:-${CHROME_REMOTE_DEBUGGING_PORT:-9223}}"
CHROME_REMOTE_DEBUGGING_ADDRESS="${CHROME_REMOTE_DEBUGGING_ADDRESS:-127.0.0.1}"
PROXY_EXTENSION_DIR="${PROXY_EXTENSION_DIR:-/home/kernel/extensions/proxy}"
ENABLE_PROXY_EXTENSION="${ENABLE_PROXY_EXTENSION:-true}"
BROWSER_KIOSK="${BROWSER_KIOSK:-true}"
BROWSER_MODE_FILE="${BROWSER_MODE_FILE:-/tmp/popcorn-browser-mode}"
CHROMIUM_POLICY_DIR="${CHROMIUM_POLICY_DIR:-/etc/chromium/policies/managed}"
CHROMIUM_POLICY_VARIANT_DIR="${CHROMIUM_POLICY_VARIANT_DIR:-/etc/chromium/policy-variants}"

BROWSER_PROFILE_DIR="${BROWSER_PROFILE_DIR:-$HOME/user-data}"
mkdir -p "$BROWSER_PROFILE_DIR"
rm -f "$BROWSER_PROFILE_DIR/SingletonLock" "$BROWSER_PROFILE_DIR/SingletonSocket" "$BROWSER_PROFILE_DIR/SingletonCookie"

# The noVNC/CDP proxy starts before allocation, so publish the selected mode in
# a tiny shared file it can re-read while the managed launcher switches this pod.
# Missing/invalid files fail closed to kiosk in the proxy.
if [[ "$BROWSER_KIOSK" == "true" ]]; then
  BROWSER_MODE=kiosk
  BROWSER_KIOSK_JS=true
else
  BROWSER_MODE=normal
  BROWSER_KIOSK_JS=false
fi
printf '%s\n' "$BROWSER_MODE" >"$BROWSER_MODE_FILE"

if [[ "$REPLACE_DEFAULT_PAGE" == "true" ]]; then
  reclaim_policy="${CHROMIUM_POLICY_VARIANT_DIR}/policy.reclaim-portal.json"
  managed_policy="${CHROMIUM_POLICY_DIR}/policy.json"
  if [[ -f "$reclaim_policy" ]]; then
    mkdir -p "$CHROMIUM_POLICY_DIR"
    cp "$reclaim_policy" "$managed_policy"
  else
    echo "[start-chromium] REPLACE_DEFAULT_PAGE=true but ${reclaim_policy} is missing; keeping default policy" >&2
  fi
fi

# -----------------------------------------------------------------------------
# Stealth fingerprint / persona
# -----------------------------------------------------------------------------
# The `chromium` command is Tilion Fortress (a stealth stock-Chromium fork); its
# launcher applies a persona via --uxr-* + TILION_TZ/LANG. The seed/timezone/locale
# machinery below feeds that (TZ/locale) and the opt-in BROWSER=fingerprint path
# (fingerprint-chromium, which consumes CLOAK_SEED). The goal is to present as a
# regular, COHERENT desktop Chrome session to bot classifiers (Akamai BMP, Cloudflare
# Bot Management, reCAPTCHA Enterprise, Kasada) rather than headless-Chrome-on-Linux.
# The default persona is LINUX (PERSONA below): this box's real substrate — TLS/JA4
# shape, DejaVu-only fonts, SwiftShader/Vulkan renderer — is Linux, so a Linux persona
# has nothing to contradict; a Windows persona over it is the tell classifiers catch.
#
# --fingerprint-platform=windows spoofs navigator.platform, userAgentData,
# the User-Agent string, and Sec-CH-UA-Platform to Windows. That alone is a
# trap unless timezone, locale, and Date arithmetic agree — a "Windows" UA
# reporting Etc/UTC + lang=C is the tell that closes it. So seed, timezone,
# and locale are all persisted in user-data and stay stable across restarts
# (flipping any of them against the same cookie jar is itself a bot signal).
CLOAK_PROFILE_DIR="$BROWSER_PROFILE_DIR"
mkdir -p "$CLOAK_PROFILE_DIR"

# Optional profile-seed bundle: if $CLOAK_PROFILE_SEED points at a tarball and
# the profile is empty, extract it. This is how instances start pre-warmed /
# pre-authenticated — cookies, localStorage, and the persisted fingerprint
# seed survive. The bundle is a *credential*; treat it like a password.
if [[ -n "${CLOAK_PROFILE_SEED:-}" ]] \
   && [[ -f "$CLOAK_PROFILE_SEED" ]] \
   && [[ ! -e "$CLOAK_PROFILE_DIR/.cloak-fingerprint-seed" ]] \
   && [[ ! -e "$CLOAK_PROFILE_DIR/Default" ]]; then
  echo "[start-chromium] seeding profile from $CLOAK_PROFILE_SEED"
  tar -xzf "$CLOAK_PROFILE_SEED" -C "$CLOAK_PROFILE_DIR" \
    && echo "[start-chromium] profile seed restored" \
    || echo "[start-chromium] profile seed extraction failed (continuing with empty profile)" >&2
fi

# Fingerprint seed. Priority: env override -> persisted file -> fresh CSPRNG.
# CLOAK_FINGERPRINT_SEED is the escape hatch for the WebGL-GPU mismatch: the
# seed maps deterministically to a spoofed GPU renderer string, and some seeds
# resolve to flagship discrete GPUs which, under this image's SwiftShader
# rasterization, are a deterministic Akamai tell (pixel-readback never matches
# a real NVIDIA/AMD driver). Pin a seed that resolves to an integrated GPU.
# We use /dev/urandom (32-bit) not bash $RANDOM (15-bit, collides at fleet scale).
#
# Both sources are untrusted text: the env override comes from the deployment and
# the file from whatever a previous boot (or a partial write) left behind. The seed
# is fed to arithmetic below (--uxr-canvas-seed=$(( CLOAK_SEED * 7919 ... ))), and
# under `set -u` a value like "abc" is read as an unset arithmetic variable and
# ABORTS browser startup; a leading zero would silently be read as octal. So
# validate first and fall back to a fresh seed rather than failing to boot.
CLOAK_SEED_FILE="$CLOAK_PROFILE_DIR/.cloak-fingerprint-seed"
seed_valid() { [[ "${1:-}" =~ ^[0-9]{1,9}$ ]] && (( 10#${1} >= 1 )); }
CLOAK_SEED=""
if [[ -n "${CLOAK_FINGERPRINT_SEED:-}" ]]; then
  # Whitespace-tolerant: a value mounted from a secret/configmap routinely carries
  # a trailing newline.
  CLOAK_SEED_ENV="$(printf '%s' "$CLOAK_FINGERPRINT_SEED" | tr -d '[:space:]')"
  if seed_valid "$CLOAK_SEED_ENV"; then
    CLOAK_SEED=$(( 10#$CLOAK_SEED_ENV ))
  else
    echo "[stealth] CLOAK_FINGERPRINT_SEED is not a 1-9 digit number; ignoring it" >&2
  fi
fi
if [[ -z "$CLOAK_SEED" && -s "$CLOAK_SEED_FILE" ]]; then
  CLOAK_SEED_PERSISTED="$(tr -d '[:space:]' < "$CLOAK_SEED_FILE" | head -c 16)"
  if seed_valid "$CLOAK_SEED_PERSISTED"; then
    CLOAK_SEED=$(( 10#$CLOAK_SEED_PERSISTED ))
  else
    # A corrupt file must not pin the session: regenerating changes the persona
    # once, which is strictly better than a browser that will not start.
    echo "[stealth] persisted fingerprint seed is corrupt; regenerating" >&2
  fi
fi
if [[ -z "$CLOAK_SEED" ]]; then
  CLOAK_SEED=$(( $(od -An -N4 -tu4 < /dev/urandom | tr -d ' ') % 9000000 + 1000000 ))
fi
# Write back the NORMALIZED value, so the next boot reads a seed this same check
# accepts (and the file self-heals from a bad env override or a torn write).
echo "$CLOAK_SEED" > "$CLOAK_SEED_FILE" || true

# geoip: resolve tz/locale from the egress at boot and persist. During pre-warm
# there is NO proxy yet, so this reflects the cluster's own egress IP — the
# correct baseline for that moment. When the in-browser extension proxy is later
# assigned at runtime, the control plane re-aligns tz to the proxy exit via CDP
# Emulation.setTimezoneOverride (before the session touches a target). Default
# on; needs curl; fail open. NOTE: reCAPTCHA scoring is IP-driven — this is
# coherence hygiene, not a reCAPTCHA fix. Leave CLOAK_TIMEZONE/CLOAK_LOCALE empty
# so geoip can fill them; an explicit -e value still wins (it's non-empty).
CLOAK_GEOIP="${CLOAK_GEOIP:-true}"
CLOAK_TIMEZONE="${CLOAK_TIMEZONE:-}"
CLOAK_LOCALE="${CLOAK_LOCALE:-}"
CLOAK_TZ_FILE="$CLOAK_PROFILE_DIR/.cloak-fingerprint-timezone"
CLOAK_LOCALE_FILE="$CLOAK_PROFILE_DIR/.cloak-fingerprint-locale"

if [[ ! -s "$CLOAK_TZ_FILE" || ! -s "$CLOAK_LOCALE_FILE" ]] \
   && [[ "$CLOAK_GEOIP" == "true" ]] \
   && command -v curl >/dev/null 2>&1; then
  echo "[start-chromium] geoip: resolving timezone/locale from exit IP…"

  # Provider 1: ipapi.co (HTTPS; gives timezone AND languages). Its free tier
  # rate-limits hard (HTTP 429 with an {"error":true} body), and when it does the
  # timezone silently fell back to America/Los_Angeles below — a US clock on a
  # non-US exit IP is the textbook timezone<->IP mismatch that trips "VPN
  # detected". Treat an error body as no answer and fall through.
  # JSON string extractor that works for BOTH pretty (ipapi.co) and compact
  # single-line (ip-api.com) bodies — the old awk-by-quote-field logic silently
  # returned the wrong value on compact JSON.
  json_str() { sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" | head -n1; }

  GEOIP_JSON="$(curl -s --max-time 8 https://ipapi.co/json/ 2>/dev/null || true)"
  case "$GEOIP_JSON" in *'"error"'*|'') GEOIP_JSON='' ;; esac
  if [[ -n "$GEOIP_JSON" ]]; then
    GEOIP_TZ="$(printf '%s' "$GEOIP_JSON" | json_str timezone)"
    GEOIP_LANGS="$(printf '%s' "$GEOIP_JSON" | json_str languages)"
    GEOIP_LOCALE="$(printf '%s' "$GEOIP_LANGS" | awk -F',' '{print $1}')"
  fi

  # Provider 2: ip-api.com (no key, reliable) when ipapi.co is rate-limited. It
  # returns timezone directly; locale falls back to its own default below.
  if [[ -z "${GEOIP_TZ:-}" ]]; then
    GEOIP_JSON2="$(curl -s --max-time 8 'http://ip-api.com/json/?fields=status,timezone' 2>/dev/null || true)"
    case "$GEOIP_JSON2" in *'"success"'*)
      GEOIP_TZ="$(printf '%s' "$GEOIP_JSON2" | json_str timezone)" ;;
    esac
  fi

  [[ -n "${GEOIP_TZ:-}" ]]     && CLOAK_TIMEZONE="${CLOAK_TIMEZONE:-$GEOIP_TZ}"
  [[ -n "${GEOIP_LOCALE:-}" ]] && CLOAK_LOCALE="${CLOAK_LOCALE:-$GEOIP_LOCALE}"
  if [[ -n "${GEOIP_TZ:-}" ]]; then
    echo "[start-chromium] geoip: timezone=${CLOAK_TIMEZONE:-?} locale=${CLOAK_LOCALE:-?}"
  else
    echo "[start-chromium] geoip: all providers failed (offline/rate-limited); using env/defaults"
  fi
fi

# Persisted-file priority: file -> env (or geoip-resolved) -> fallback.
if [[ -s "$CLOAK_TZ_FILE" ]]; then
  CLOAK_TIMEZONE="$(cat "$CLOAK_TZ_FILE")"
else
  CLOAK_TIMEZONE="${CLOAK_TIMEZONE:-${TZ:-America/Los_Angeles}}"
  echo "$CLOAK_TIMEZONE" > "$CLOAK_TZ_FILE"
fi

if [[ -s "$CLOAK_LOCALE_FILE" ]]; then
  CLOAK_LOCALE="$(cat "$CLOAK_LOCALE_FILE")"
else
  CLOAK_LOCALE="${CLOAK_LOCALE:-en-US}"
  echo "$CLOAK_LOCALE" > "$CLOAK_LOCALE_FILE"
fi

# Align the OS-level TZ / zoneinfo so Date.getTimezoneOffset() matches the
# spoofed Intl timezone. A mismatch here is a one-line correlation Akamai catches.
export TZ="$CLOAK_TIMEZONE"
if [[ -r "/usr/share/zoneinfo/$CLOAK_TIMEZONE" ]]; then
  ln -sf "/usr/share/zoneinfo/$CLOAK_TIMEZONE" /etc/localtime 2>/dev/null || true
  echo "$CLOAK_TIMEZONE" > /etc/timezone 2>/dev/null || true
fi

# BROWSER selects the engine. Default (and the only one baked in) is Tilion
# Fortress — a stealth STOCK-Chromium fork at /opt/tilion/tilion (also symlinked
# to `chromium`). Its launcher applies a coherent Windows persona via its own
# --uxr-* defaults, so NONE of the --fingerprint-* flags apply; only TILION_TZ /
# TILION_LANG tune it. (CloakBrowser was removed — Fortress replaced it.)
# BROWSER=fingerprint is an OPT-IN alternative: the bundled fingerprint-chromium
# (adryfish, ungoogled 148, amd64-only), a DIFFERENT dialect —
# --timezone/--lang/--accept-lang + --disable-non-proxied-udp, NOT
# --fingerprint-timezone/-locale/-webrtc-ip — only present if baked in.
BROWSER="${BROWSER:-fortress}"
# SwiftShader software WebGL + CPU compositor — shared by both browsers. Keeps
# WebGL functional (needed for the renderer spoof) while skipping the GPU process.
gpu_flags=(--disable-gpu --disable-gpu-compositing --enable-unsafe-swiftshader --use-gl=swiftshader --ignore-gpu-blocklist)

# Platform coherence (reCAPTCHA v3/Enterprise + anti-bot). Canvas/WebGL are
# driver/OS-bound; strict detectors cross-check the spoofed platform against the
# actual render backend, and a claimed hardware GPU that renders in software
# (SwiftShader) is a high-confidence tell. This image renders via SwiftShader on
# Linux, so presenting platform=windows is an incoherence a strict key can catch
# (see RECAPTCHA-RESEARCH.md §5). Default stays 'windows' for continuity; set
# CLOAK_FINGERPRINT_PLATFORM=linux for a COHERENT Linux identity that matches the
# real backend — recommended for strict reCAPTCHA flows.
CLOAK_FP_PLATFORM="${CLOAK_FINGERPRINT_PLATFORM:-windows}"
# Only the fingerprint-chromium branch consumes --fingerprint-platform; Fortress
# manages its own persona via --uxr-* (its WebGL/GPU coherence is tuned there).
if [[ "$BROWSER" == "fingerprint" && "$CLOAK_FP_PLATFORM" == "windows" ]]; then
  echo "[stealth] WARN: fingerprint-platform=windows on a SwiftShader/Linux backend is a known coherence tell for strict reCAPTCHA; consider CLOAK_FINGERPRINT_PLATFORM=linux" >&2
fi

if [[ "$BROWSER" == "fingerprint" ]]; then
  CHROME_BIN="/opt/fingerprint-chromium/chrome"
  [[ -x "$CHROME_BIN" ]] || { echo "[start-chromium] BROWSER=fingerprint but $CHROME_BIN is missing (fingerprint-chromium is x86_64-only; build/run on amd64)" >&2; exit 1; }
  cloak_flags=(
    "--fingerprint=${CLOAK_SEED}"
    "--fingerprint-platform=${CLOAK_FP_PLATFORM}"
    "--timezone=${CLOAK_TIMEZONE}"
    "--lang=${CLOAK_LOCALE}"
    "--accept-lang=${CLOAK_LOCALE}"
    "${gpu_flags[@]}"
  )
  # WebRTC leak control (fingerprint-chromium dialect: force UDP through the proxy).
  if [[ -n "${CLOAK_WEBRTC_IP:-}" || "$CLOAK_GEOIP" == "true" ]]; then
    cloak_flags+=("--disable-non-proxied-udp")
  fi
  echo "[stealth] browser: fingerprint-chromium 148 (ungoogled) — dialect --fingerprint/-platform/--timezone/--lang"
elif [[ "$BROWSER" == "fortress" ]]; then
  # Tilion Fortress: stable stealth Chromium 149 (x86_64-only), a STOCK-Chromium fork
  # with C++ persona patches. /opt/tilion/tilion is a bash launcher that applies
  # a coherent default Windows persona via --uxr-* flags + bundled Windows fonts,
  # and points VK_ICD at its own SwiftShader. It has NO --fingerprint-* dialect,
  # so we pass NONE of the CloakBrowser flags; the only coherence knobs are the
  # TILION_* env vars, and the persona is emitted by the wrapper itself.
  CHROME_BIN="/opt/tilion/tilion"
  [[ -x "$CHROME_BIN" ]] || { echo "[start-chromium] BROWSER=fortress but $CHROME_BIN is missing (Tilion Fortress is x86_64-only; build/run on amd64)" >&2; exit 1; }
  # The wrapper reads these to keep TZ/locale coherent from the first renderer tick.
  export TILION_TZ="$CLOAK_TIMEZONE"
  # --uxr-languages expects an Accept-Language-style list. Expand a single region
  # locale (en-IN) to "en-IN,en" so navigator.languages looks like a real browser;
  # pass through anything that's already a list or has no region subtag.
  if [[ "$CLOAK_LOCALE" == *,* || "$CLOAK_LOCALE" != *-* ]]; then
    export TILION_LANG="$CLOAK_LOCALE"
  else
    export TILION_LANG="$CLOAK_LOCALE,${CLOAK_LOCALE%%-*}"
  fi
  # No --fingerprint-* / gpu_flags: Fortress supplies platform/UA/hw via --uxr
  # defaults and bundles its own SwiftShader ICD. GPU_PERSONA below chooses the
  # reported WebGL/WebGPU identity; the default is Intel integrated because it
  # clears Sannysoft without lowering the current CreepJS score. Override persona
  # with CHROMIUM_FLAGS='--uxr-... ' if needed, or TILION_NO_DEFAULTS=1 for a bare
  # launch.
  # Persona platform. PERSONA=windows restores the wrapper's own Windows default.
  #
  # Linux is expressible only since the 150 image: before it, explicit --uxr-ua-os /
  # --uxr-ua-platform were OVERWRITTEN by the generated persona, so the UA stayed
  # Windows while navigator.platform followed the flag — and that UA-vs-platform
  # mismatch is itself what read as tampering (tiliondev/fortress#25).
  #
  # Passed as ARRAY elements, not through CHROMIUM_FLAGS: two of these values contain
  # spaces, and the env path is word-split, which turns them into invalid args and
  # Chromium then fails to start at all.
  #
  # KNOWN COHERENCE GAP: the Dockerfile bundles Fortress's Windows fonts and rewrites every
  # Noto face to the Windows family a real Windows box uses (Nirmala UI, Segoe UI,
  # Microsoft YaHei …). That was built to match the WINDOWS persona; under a Linux one a
  # font probe sees a "Linux" box enumerating Segoe UI, which is the same class of
  # cross-property contradiction this change is meant to remove. Switching the font set
  # to a Linux-plausible one (DejaVu/Liberation/Noto) is the follow-up.
  #
  # Upstream also notes a Linux desktop persona is RARER than Windows, and rarity is
  # itself a signal — so this is a deliberate trade, not a strict improvement.
  cloak_flags=()
  # Per-profile canvas/audio noise seeds.
  #
  # Fortress's defaults are CONSTANTS — verified from /proc/<pid>/cmdline on a running
  # container: --uxr-canvas-seed=778899 --uxr-audio-seed=445566. So every container
  # launched with defaults, ours and everyone else's, renders the SAME noised canvas and
  # audio fingerprint. That is a cross-instance correlation handle: a site that sees two
  # of our sessions can tell they are the same box, and the value is shared with every
  # other Fortress user on defaults. (The 150 notes' "per-clone divergence" means the
  # seed is now applied rather than ignored — the default value is still fixed.)
  #
  # CLOAK_SEED is already random on first boot and persisted in the profile
  # (.cloak-fingerprint-seed), so deriving from it gives what a real device has: a
  # fingerprint that is STABLE across restarts but UNIQUE per user. Two derivations so
  # canvas and audio do not move together.
  cloak_flags+=(
    "--uxr-canvas-seed=$(( (CLOAK_SEED * 7919) % 8999999 + 1000000 ))"
    "--uxr-audio-seed=$(( (CLOAK_SEED * 6271) % 8999999 + 1000000 ))"
  )

  persona="${PERSONA:-linux}"
  if [[ "$persona" == "linux" ]]; then
    cloak_flags+=(
      "--uxr-platform=Linux x86_64"
      "--uxr-ua-platform=Linux"
      "--uxr-ua-os=X11; Linux x86_64"
      "--uxr-ua-arch=x86"
      "--uxr-ua-bitness=64"
      "--uxr-ua-brand=Google Chrome"
      "--uxr-ua-platform-version=${CLOAK_KERNEL_VERSION:-6.8.0}"
    )
  fi
  case "${GPU_PERSONA:-swiftshader}" in
    swiftshader)
      cloak_flags+=(
        "--uxr-webgl-vendor=Google Inc. (Google)"
        "--uxr-webgl-renderer=ANGLE (Google, Vulkan 1.3.0 (SwiftShader Device (Subzero) (0x0000C0DE)), SwiftShader driver)"
        "--uxr-webgpu-vendor=google"
        "--uxr-webgpu-architecture=swiftshader"
        "--uxr-webgpu-description=SwiftShader Device (Subzero)"
      )
      ;;
    intel)
      cloak_flags+=(
        "--uxr-webgl-vendor=Google Inc. (Intel)"
        "--uxr-webgl-renderer=ANGLE (Intel, Intel(R) UHD Graphics 630 (0x00003E9B) Direct3D11 vs_5_0 ps_5_0, D3D11)"
        "--uxr-webgpu-vendor=intel"
        "--uxr-webgpu-architecture=gen-9"
        "--uxr-webgpu-description=Intel(R) UHD Graphics 630"
      )
      ;;
    nvidia) ;; # the wrapper's own default persona (RTX 3060 claim), for comparison
  esac
  echo "[stealth] browser: Tillion Fortress (stable stealth Chromium 150) — persona=$persona gpu=${GPU_PERSONA:-swiftshader}; TILION_TZ=$CLOAK_TIMEZONE TILION_LANG=$TILION_LANG"
else
  # CloakBrowser was removed; only 'fortress' (default) and 'fingerprint' remain.
  echo "[start-chromium] unknown BROWSER='$BROWSER' (valid: fortress [default], fingerprint). CloakBrowser was removed from this image." >&2
  exit 1
fi

# Strict reCAPTCHA v3 keys score on the 3rd-party cookie Google uses for
# cross-site *reputation* (NID) — that, not any fingerprint leak, is what fails
# strict v3. Fortress is stock Chromium (3p cookies allowed in normal windows by
# default), but Chromium is phasing 3pc out (TrackingProtection3pcd) and the
# fingerprint-chromium branch is ungoogled (blocks it outright), so we stack
# every RUNTIME lever to keep the reputation cookie flowing: (1) managed policy
# BlockThirdPartyCookies=false + CookiesAllowedForUrls (in policies/*.json);
# (2) the profile cookie-controls pref forced to "allow all"; (3) disable the
# 3pc-deprecation feature. Default on; set CLOAK_ALLOW_3P_COOKIES=false to opt out.
# AutofillReintroduceHybridPasskeyDropdownItem is the Chromium 149 feature that
# puts the "Use passkey from another device" (hybrid/caBLE) item in the username
# autofill dropdown — the bubble Google's sign-in shows on the email field.
# Disabling it removes that item natively (no JS patch = no fingerprint surface)
# while leaving PublicKeyCredential and modal WebAuthn intact. (The older
# WebAuthenticationConditionalUI feature was graduated/removed in 149 — verified
# absent from the binary — so disabling that was a no-op.) Set
# CLOAK_DISABLE_PASSKEY=false to keep passkeys.
# NOTE: Chromium honours only the LAST --disable-features on the command line,
# and cloak_flags is appended last, so the passkey feature is added to BOTH the
# cloak_flags list here AND the base flags list below to cover either config.
_passkey_feat=""
if [[ "${CLOAK_DISABLE_PASSKEY:-true}" == "true" ]]; then
  _passkey_feat=",AutofillReintroduceHybridPasskeyDropdownItem"
fi
if [[ "${CLOAK_ALLOW_3P_COOKIES:-true}" == "true" ]]; then
  cloak_flags+=("--disable-features=TrackingProtection3pcd${_passkey_feat}")
  # Force the profile cookie-controls pref to "allow all" (cookie_controls_mode=0)
  # so no blocking default stops Google's cross-site reCAPTCHA reputation cookie
  # (NID). Verified with CDP
  # requestWillBeSentExtraInfo: default => NID blocked (reason UserPreferences);
  # cookie_controls_mode=0 => NID flows. This gates reCAPTCHA v3 AND reCAPTCHA
  # Enterprise (e.g. Netflix login).
  #
  # MUST run on EVERY boot, not just fresh profiles. The old code only wrote this
  # when Preferences was absent, so every WARMED/persisted profile — exactly the
  # ones that accumulate reputation — silently kept ungoogled's blocking default
  # and re-blocked NID. We now merge just this one key, preserving all other
  # warmed state (cookies, history, login). No jq/python in the image, so GNU sed.
  pref_file="$CLOAK_PROFILE_DIR/Default/Preferences"
  mkdir -p "$CLOAK_PROFILE_DIR/Default"
  if [[ -s "$pref_file" ]]; then
    if grep -q '"cookie_controls_mode"' "$pref_file"; then
      # key present -> set it to 0 (do not touch anything else)
      sed -i 's/"cookie_controls_mode"[[:space:]]*:[[:space:]]*[0-9]\+/"cookie_controls_mode":0/g' "$pref_file"
    else
      # key absent -> inject at the top of the "profile" object
      sed -i 's/"profile"[[:space:]]*:[[:space:]]*{/"profile":{"cookie_controls_mode":0,/' "$pref_file"
    fi
  else
    printf '%s' '{"profile":{"cookie_controls_mode":0,"default_content_setting_values":{"cookies":1}}}' > "$pref_file"
  fi
  # Sanity: confirm the pref is now 0; warn loudly if the merge didn't take.
  if ! grep -q '"cookie_controls_mode":0' "$pref_file" 2>/dev/null; then
    echo "[stealth] WARN: cookie_controls_mode=0 not present after merge — reCAPTCHA reputation cookie may be blocked" >&2
  fi
  echo "[stealth] 3p-cookies: policy + prefs(cookie_controls_mode=0, enforced on warmed profiles too) + disable TrackingProtection3pcd (reCAPTCHA v3/Enterprise reputation)"
fi

if [[ "$BROWSER" == "fingerprint" ]]; then
  echo "[stealth] fingerprint-chromium: seed=${CLOAK_SEED} platform=${CLOAK_FP_PLATFORM} tz=${CLOAK_TIMEZONE} locale=${CLOAK_LOCALE}"
  echo "[stealth] If the WebGL renderer reports a flagship discrete GPU, pin CLOAK_FINGERPRINT_SEED to a seed that maps to an integrated GPU."
fi
echo "[stealth] geoip resolution: ${CLOAK_GEOIP}"
echo "[stealth] WebRTC IP spoof: ${CLOAK_WEBRTC_IP:-${CLOAK_GEOIP:+auto}}"

flags=(
  "--remote-debugging-address=${CHROME_REMOTE_DEBUGGING_ADDRESS}"
  "--remote-debugging-port=${CDP_INTERNAL_PORT}"
  "--remote-allow-origins=*"
  "--user-data-dir=${BROWSER_PROFILE_DIR}"
  "--password-store=basic"
  "--no-sandbox"
  "--disable-setuid-sandbox"
  "--no-first-run"
  "--no-default-browser-check"
  "--disable-background-networking"
  "--disable-dev-shm-usage"
  "--disable-sync"
  # MediaRouter is intentionally NOT disabled: doing so empties
  # chrome.cast.isAvailable(), which is a bot tell real Chrome never exhibits.
  "--disable-features=Translate,OptimizationHints${_passkey_feat}"
  "--window-size=${WIDTH},${WINDOW_HEIGHT}"
  # Allow window.open() popups (OAuth "Continue with X", payment popups, etc.).
  # Without this the popup blocker returns null from window.open, so popup-based
  # login flows silently die. Real user clicks are gestures, but kiosk + the
  # blocker still interfere; disabling the blocker makes popups reliable.
  "--disable-popup-blocking"
  "${cloak_flags[@]}"
)

if [[ "$BROWSER_KIOSK" == "true" ]]; then
  flags+=("--kiosk")
fi

if [[ "$ENABLE_PROXY_EXTENSION" == "true" && -f "${PROXY_EXTENSION_DIR}/manifest.json" ]]; then
  # The extension normally keeps kiosk popups chromeless. Give each isolated
  # pod's unpacked extension the same mode so normal MCP windows retain chrome.
  printf 'globalThis.POPCORN_BROWSER_KIOSK = %s;\n' "$BROWSER_KIOSK_JS" \
    >"${PROXY_EXTENSION_DIR}/browser-mode.js"
  flags+=(
    "--disable-extensions-except=${PROXY_EXTENSION_DIR}"
    "--load-extension=${PROXY_EXTENSION_DIR}"
  )
fi

if [[ "${CHROMIUM_FLAGS:-}" != "" ]]; then
  eval "extra_flags=(${CHROMIUM_FLAGS})"
  flags+=("${extra_flags[@]}")
fi

exec "$CHROME_BIN" "${flags[@]}" "$APP_URL"
